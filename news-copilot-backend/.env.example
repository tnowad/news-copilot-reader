# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=postgresql://news_copilot:password@localhost:5432/news_copilot

# JWT
JWT_SECRET_KEY=change-this-to-another-random-jwt-secret
JWT_ACCESS_TOKEN_HOURS=1
JWT_REFRESH_TOKEN_DAYS=30

# Mail (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@newscopilot.example.com

# Redis
REDIS_URL=redis://localhost:6379/0

# Cache
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=3600

# Uploads
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# AI/ML (optional)
OPENAI_API_KEY=
HUGGING_FACE_API_KEY=

# Rate Limiting
RATELIMIT_DEFAULT=1000 per hour

# Logging
LOG_LEVEL=INFO

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
